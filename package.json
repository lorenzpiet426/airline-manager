{
  "name": "airline-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A realistic airline management game (personal, non-commercial).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:download": "node tools/download-world-data.ts",
    "data:build": "node tools/build-world-data.ts && node tools/build-basemap.ts",
    "data:airlines:download": "node tools/download-airlines.ts && node tools/download-eurostat-routes.ts",
    "data:airlines:build": "node tools/build-airlines.ts && node tools/build-eurostat-routes.ts",
    "data:cpi": "node tools/download-cpi.ts && node tools/build-cpi.ts",
    "data:history": "node tools/download-history.ts && node tools/build-history.ts && node tools/build-airport-history.ts",
    "data:airlines:history": "node tools/download-airlines-history.ts && node tools/build-airline-history.ts",
    "data:rates": "node tools/download-policy-rates.ts && node tools/build-policy-rates.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "comlink": "^4.4.2",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "firebase": "13.0.0",
    "i18next": "^26.5.11",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
